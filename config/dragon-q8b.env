# Project defaults. The refresh workflow commits vendor pin updates to main.
# Bootstrap users may override COPR_OWNER and COPR_PROJECT in the environment
# or on the command line.

FEDORA_RELEASE=44
COPR_PROJECT=dragon-q8b
# Fedora kernel dist-git (src.fedoraproject.org/rpms/kernel, branch f$FEDORA_RELEASE).
# refresh-vendor.sh updates these when that branch moves.
FEDORA_KERNEL_COMMIT=916b92f09c9d9766dd7317427c969fc1a39ce00d
FEDORA_KERNEL_VERSION=7.2.12

# Fedora Cloud aarch64 images directory. test-e2e-qemu.sh resolves the
# Generic qcow2 from the CHECKSUM / productmd listing (not a frozen compose).
FEDORA_CLOUD_IMAGES_URL=https://download.fedoraproject.org/pub/fedora/linux/releases/44/Cloud/aarch64/images/

# Primary board/kernel source references.
RADXA_KERNEL_REPO=https://github.com/radxa/kernel.git
RADXA_KERNEL_REF=a4f7d514f4b3ed6b1239e817dcf765cd1c6257e2
RADXA_KERNEL_BRANCH=linux-7.0.11
RADXA_FIRMWARE_REPO=https://github.com/radxa-pkg/radxa-firmware.git
RADXA_FIRMWARE_REF=330b4bf933b927f9a6f3383dd57d28f6c652810c
RADXA_FIRMWARE_VERSION=0.2.41
RADXA_OVERLAYS_REPO=https://github.com/radxa-pkg/radxa-overlays.git
RADXA_OVERLAYS_REF=a87daf4047c82163a650fafc7e0879ed7c7f6e16

# Armbian is a secondary compatibility source for portable SC8280XP changes.
# The Q8B device tree is never sourced from Armbian; RADXA_KERNEL_REF is the
# sole authority for sc8280xp-radxa-dragon-q8b.dts.
ARMBIAN_BUILD_REPO=https://github.com/armbian/build.git
ARMBIAN_REF=1f33ee9db0063ec281d3c273ac5df5dcd6f84450
ARMBIAN_PATCH_DIR=patch/kernel/archive/sc8280xp-edge

ALSA_UCM_REPO=https://github.com/radxa-pkg/alsa-ucm-conf
ALSA_UCM_API=https://api.github.com/repos/radxa-pkg/alsa-ucm-conf
ALSA_UCM_VERSION=1.2.16.1-radxa-4

FASTRPC_REPO=https://github.com/qualcomm/fastrpc.git
FASTRPC_TAG=v1.0.6
FASTRPC_VERSION=1.0.6
FASTRPC_REF=5f0b6a33a19f3f7f0c06709846752a2caf64e413

# Qualcomm AI Runtime Community Edition from Qualcomm Software Center.
# refresh-vendor.sh selects the latest All/Any Zip and checksum-pins it.
# The SDK is downloaded by the end user after explicit acceptance of
# Qualcomm's AI Stack license; it is not redistributed by this repository.
QAIRT_VERSION=2.51.200.261021
QAIRT_DOWNLOAD_URL=https://softwarecenter.qualcomm.com/api/download/software/sdks/Qualcomm_AI_Runtime_Community/All/2.51.200.261021/v2.51.200.261021.zip
QAIRT_ARCHIVE_SHA256=c0dbd66d6eb25c5ac2d099f6eebc9a7dfd05ff8d22e96028c475efc4fbbbe2e0
QAIRT_LICENSE_SHA256=ec1dccfdcba5c6e64126e84199b8362bf4999107bfa567ebe831dbb4c461692b
QAIRT_TARGET=aarch64-oe-linux-gcc11.2
QAIRT_DSP_ARCH=68

Q8B_DTB=qcom/sc8280xp-radxa-dragon-q8b.dtb
Q8B_COMPATIBLE=radxa,dragon-q8b
