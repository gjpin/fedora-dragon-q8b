#!/usr/bin/env bash
# kernel-install plugin: merge Q8B overlays into the board DTB after the BLS
# entry exists (90-loaderentry.install). Same helper as 50-dragon-q8b.install.
set -Eeuo pipefail

COMMAND=${1:-}
KERNEL_VERSION=${2:-}

[[ "$COMMAND" == add ]] || exit 0
[[ -n "$KERNEL_VERSION" ]] || exit 0

if [[ -x /usr/libexec/dragon-q8b-refresh-boot ]]; then
    /usr/libexec/dragon-q8b-refresh-boot --kernel-version "$KERNEL_VERSION" || :
fi
exit 0
