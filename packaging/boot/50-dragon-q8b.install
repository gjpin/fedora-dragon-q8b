#!/usr/bin/env bash
# kernel-install plugin: merge Q8B overlays into the board DTB.
# Also installed as 91-dragon-q8b.install so BLS entries exist when this runs.
set -Eeuo pipefail

COMMAND=${1:-}
KERNEL_VERSION=${2:-}

[[ "$COMMAND" == add ]] || exit 0
[[ -n "$KERNEL_VERSION" ]] || exit 0

if [[ -x /usr/libexec/dragon-q8b-refresh-boot ]]; then
    /usr/libexec/dragon-q8b-refresh-boot --kernel-version "$KERNEL_VERSION" || :
fi
exit 0
